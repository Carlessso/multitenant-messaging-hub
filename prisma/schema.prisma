generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  whatsapp
  instagram

  @@map("channel")
}

enum Direction {
  inbound
  outbound

  @@map("direction")
}

model Tenant {
  id            String         @id
  name          String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  conversations Conversation[]
  messages      Message[]

  @@map("tenants")
}

model Conversation {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  channel     Channel
  contactId   String    @map("contact_id")
  contactName String?   @map("contact_name")
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  messages    Message[]

  @@unique([tenantId, channel, contactId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  externalId     String?      @map("external_id")
  direction      Direction
  text           String
  sentAt         DateTime     @map("sent_at") @db.Timestamptz(3)
  receivedAt     DateTime     @default(now()) @map("received_at") @db.Timestamptz(3)
  replyToId      String?      @unique @map("reply_to_id") @db.Uuid
  replyTo        Message?     @relation("MessageReply", fields: [replyToId], references: [id])
  reply          Message?     @relation("MessageReply")

  @@unique([tenantId, externalId])
  @@index([tenantId, receivedAt])
  @@map("messages")
}
