#!/usr/bin/env bash
# Builds and starts the whole stack. Safe to run again at any time.
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
  echo "Docker with the Compose plugin is required: https://docs.docker.com/get-docker/" >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "The Docker daemon is not running. Start Docker and try again." >&2
  exit 1
fi

if [ ! -f .env ]; then
  cp .env.example .env
  echo "Created .env from .env.example (mock LLM; set LLM_PROVIDER=gemini and GEMINI_API_KEY to use Gemini)."
fi

docker compose up --build --detach --wait

cat <<'MSG'

Everything is up.
  Web UI   http://127.0.0.1:8080
  API      http://127.0.0.1:3000
  Metrics  http://127.0.0.1:3000/metrics

Logs:     docker compose logs -f api worker
Restart:  bin/restart   (after changing code or .env)
Stop:     bin/stop      (bin/stop --wipe also deletes the data)
MSG
